---
import { site } from '../data/site';

const links = [
  { href: '#ecosystems', label: 'Work' },
  { href: '#open-source', label: 'Open source' },
  { href: '#about', label: 'About' },
  { href: '#sponsor', label: 'Sponsor' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="absolute inset-x-0 top-0 z-20">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-6 md:px-8"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="flex items-center gap-3 font-display text-lg tracking-tight text-parchment/90 transition hover:text-honey"
    >
      <img
        src={site.avatar}
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 rounded-full border border-honey/50 object-cover"
      />
      <span class="hidden sm:inline">SM</span>
    </a>
    <ul class="flex flex-wrap items-center justify-end gap-4 text-sm text-parchment/75 md:gap-7">
      {
        links.map((link) => (
          <li>
            <a class="transition hover:text-honey" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
