---
import { openSource } from '../data/site';
---

<section id="open-source" class="bg-ink px-6 py-24 text-parchment md:px-8 md:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-honey">Open source</p>
      <h2 class="font-display mt-3 text-4xl tracking-tight md:text-5xl">Selected repositories</h2>
      <p class="mt-4 text-lg leading-relaxed text-mist/90">
        Led by <span class="text-honey">filament-modules</span> and
        <span class="text-honey">flatpickr</span> — high-signal packages for Laravel and Adonis teams.
      </p>
    </div>

    <ul class="reveal-stagger mt-14 grid gap-x-10 gap-y-0 sm:grid-cols-2">
      {
        openSource.map((project) => (
          <li class="reveal border-t border-parchment/15 py-7">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-honey"
            >
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="font-display text-xl tracking-tight transition group-hover:text-honey md:text-2xl">
                  {project.name}
                </h3>
                {project.stars != null && (
                  <span class="shrink-0 text-sm tabular-nums text-mist/70">★ {project.stars}</span>
                )}
              </div>
              <p class="mt-2 text-sm text-accent-bright">{project.stack}</p>
              <p class="mt-3 text-base leading-relaxed text-mist/85">{project.description}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-10">
      <a
        class="link-accent text-sm font-semibold text-parchment"
        href="https://github.com/coolsam726"
        target="_blank"
        rel="noopener noreferrer"
      >
        See all on GitHub
      </a>
    </p>
  </div>
</section>
