---
import { site } from '../data/site';

const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="absolute inset-x-0 top-0 z-20">
  <nav class="shell flex items-center justify-between py-5" aria-label="Primary">
    <a href="#top" class="flex items-center gap-2.5 text-white/90 transition hover:text-honey">
      <img
        src={site.avatar}
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 rounded-full object-cover ring-2 ring-honey/60"
      />
      <span class="font-display text-base tracking-tight">{site.name.split(' ')[0]}</span>
    </a>
    <ul class="flex items-center gap-6 text-sm text-white/70">
      {
        links.map((link) => (
          <li>
            <a class="transition hover:text-honey" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
