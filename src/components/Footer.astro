---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-canvas px-0 py-8">
  <div class="shell flex flex-col gap-3 text-sm text-ink-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display text-base text-ink">{site.name}</p>
    <p>© {year} · Nairobi</p>
  </div>
</footer>
