---
import Header from './Header.astro';
import { site } from '../data/site';
---

<section id="top" class="relative isolate min-h-dvh overflow-hidden text-white">
  <div class="hero-plane absolute inset-0 -z-10" aria-hidden="true"></div>
  <Header />

  <div class="shell flex min-h-dvh flex-col justify-center py-28">
    <div class="max-w-3xl">
      <img
        src={site.avatar}
        alt={`${site.name} profile photo`}
        width="96"
        height="96"
        class="avatar-live h-20 w-20 rounded-full object-cover ring-[3px] ring-honey md:h-24 md:w-24"
        fetchpriority="high"
      />

      <h1
        class="rise rise-1 font-display mt-8 text-[clamp(3.75rem,14vw,8rem)] leading-[0.9] tracking-[-0.04em]"
      >
        Sam Maosa
      </h1>

      <p class="rise rise-2 mt-6 max-w-xl text-xl text-white/85 md:text-2xl">
        Ecosystem builder &amp; full-stack craftsman
      </p>

      <p class="rise rise-3 mt-4 max-w-md text-base leading-relaxed text-mist md:text-lg">
        Frameworks, plugins, and end-user software — built to ship.
      </p>

      <div class="rise rise-4 mt-10 flex flex-wrap gap-3">
        <a class="btn btn-honey" href="#work">See the work</a>
        <a class="btn btn-line" href="#contact">Hire me</a>
      </div>
    </div>
  </div>
</section>
