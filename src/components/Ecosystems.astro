---
import { ecosystems } from '../data/site';
---

<section id="ecosystems" class="bg-parchment px-6 py-24 md:px-8 md:py-32">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">Ecosystems</p>
      <h2 class="font-display mt-3 text-4xl tracking-tight text-ink md:text-5xl">
        Pillars I build and maintain
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-muted">
        From Almasix and Shamar to Filament plugins, JetBrains tooling, and Odoo payments —
        systems meant to last in production.
      </p>
    </div>

    <ol class="reveal-stagger mt-16 divide-y divide-ink/10 border-y border-ink/10">
      {
        ecosystems.map((item, index) => (
          <li class="reveal group grid gap-4 py-8 md:grid-cols-[4rem_1fr_auto] md:items-baseline md:gap-8">
            <span class="font-display text-sm text-accent tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="font-display text-2xl tracking-tight text-ink transition group-hover:text-accent md:text-3xl">
                  {item.name}
                </h3>
                <span class="text-sm text-clay">{item.tag}</span>
              </div>
              <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-muted">{item.summary}</p>
            </div>
            <div class="flex flex-wrap gap-4 text-sm font-semibold md:justify-end">
              <a class="link-accent text-ink" href={item.href} target="_blank" rel="noopener noreferrer">
                Open
              </a>
              {item.secondaryHref && (
                <a
                  class="link-accent text-ink-muted"
                  href={item.secondaryHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.secondaryLabel ?? 'More'}
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
