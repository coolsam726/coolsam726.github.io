---
import { site } from '../data/site';
---

<section id="sponsor" class="bg-parchment px-6 py-24 md:px-8 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-honey">Sponsor</p>
      <h2 class="font-display mt-3 text-4xl tracking-tight text-ink md:text-5xl">
        Support the work
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-muted">
        If my plugins, frameworks, or tools save you time — sponsorship keeps the maintenance going.
      </p>
    </div>

    <ul class="reveal-stagger mt-12 grid gap-4 sm:grid-cols-3">
      {
        site.sponsors.map((item) => (
          <li class="reveal">
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-card group flex h-full flex-col border border-ink/10 bg-parchment-dim px-6 py-7 transition hover:-translate-y-1 hover:border-honey focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            >
              <span class="font-display text-2xl text-ink transition group-hover:text-accent">{item.label}</span>
              <span class="mt-2 text-sm text-ink-muted">{item.hint}</span>
              <span class="link-accent mt-6 text-sm font-semibold text-accent">Open →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
