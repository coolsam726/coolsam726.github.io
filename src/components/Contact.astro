---
import { site } from '../data/site';

const socials = [
  { label: 'X', href: site.links.twitter },
  { label: 'Discord', href: site.links.discord },
  { label: 'Facebook', href: site.links.facebook },
  { label: 'GitHub', href: site.links.github },
];
---

<section id="contact" class="bg-canvas py-20 md:py-28">
  <div class="shell">
    <div class="reveal max-w-2xl">
      <p class="text-sm font-semibold text-honey">Contact</p>
      <h2 class="font-display mt-2 text-4xl tracking-tight text-ink md:text-5xl">
        Let’s build something
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted">
        Consultancy, collaboration, or a full product. Reach me at
        <a class="ink-link font-semibold text-ink" href={site.links.email}>devmaosa@gmail.com</a>.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-honey" href={site.links.email}>Email Sam</a>
        <a class="btn btn-ink" href={site.links.github} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
    </div>

    <div class="reveal mt-16 grid gap-10 border-t border-ink/10 pt-10 md:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">Social</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-base font-semibold text-ink">
          {
            socials.map((item) => (
              <li>
                <a class="ink-link" href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="sponsor">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">Sponsor</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-base font-semibold text-ink">
          {
            site.sponsors.map((item) => (
              <li>
                <a class="ink-link" href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
