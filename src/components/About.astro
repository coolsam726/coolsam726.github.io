---
import { site } from '../data/site';
---

<section id="about" class="border-y border-ink/10 bg-canvas-soft py-20 md:py-28">
  <div class="shell grid gap-12 md:grid-cols-[1.4fr_1fr] md:gap-16 md:items-start">
    <div class="reveal">
      <p class="text-sm font-semibold text-accent">About</p>
      <h2 class="font-display mt-2 text-4xl tracking-tight text-ink md:text-5xl">
        Simple brief
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink-muted">
        I build ecosystems and ship products — frameworks, IDE plugins, ERP modules, and end-user
        software. Through <span class="text-ink font-medium">SavannaBits</span> and work at
        <span class="text-ink font-medium">Strathmore</span>, based in {site.location}.
      </p>
    </div>

    <aside class="reveal space-y-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">Stack</p>
        <p class="mt-3 text-lg leading-relaxed text-ink">
          {site.languages.join(' · ')}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-muted">With</p>
        <p class="mt-3 text-lg leading-relaxed text-ink">
          {site.companies.join(' · ')}
        </p>
      </div>
    </aside>
  </div>
</section>
